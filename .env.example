# docker compose 전체 실행용 (루트 docker-compose.yml)
# cp .env.example .env 후 값을 채웁니다. .env는 커밋하지 않습니다.

DB_NAME=devflow
DB_USERNAME=devflow
DB_PASSWORD=

# 32자 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION=3600000

# Webhook 공유 토큰 (선택, openssl rand -hex 32). 비우면 해당 Webhook을 받지 않음
DEPLOY_WEBHOOK_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=

# 운영 상태·파이프라인 (선택). Prometheus 주소가 없으면 화면에 "확인 불가"로 표시
PROMETHEUS_URL=
GITHUB_TOKEN=
# 외부 조회 캐시: memory(기본) | redis (REDIS_HOST, REDIS_PASSWORD 필요)
CACHE_TYPE=memory

# 소셜 로그인 (선택). 로컬용 GitHub OAuth App 콜백: http://localhost:3000/login/oauth2/code/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
