SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/devflow
DB_USERNAME=devflow
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=3600000

# Frontend가 다른 주소에서 Backend를 직접 호출할 때 허용할 주소 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Webhook 서버 공용 토큰 (선택, 운영자용). 보통은 프로젝트 설정에서 발급하는 프로젝트 토큰(WT2)을 사용
DEPLOY_WEBHOOK_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=

# 프로젝트별 클라우드 연결 (Prometheus 주소·AWS 역할은 화면에서 프로젝트마다 등록)
DEVFLOW_CLOUD_ALLOW_PRIVATE_NETWORK=true
# 사용자 역할 신뢰 정책에 넣을 DevFlow Backend 주체 ARN (IRSA 역할 등)
DEVFLOW_AWS_PRINCIPAL_ARN=
# Prometheus 토큰 암호화 키 (openssl rand -base64 32, 비우면 JWT_SECRET에서 파생)
DEVFLOW_ENCRYPTION_KEY=
# 파이프라인(C1)·저장소 연결(G1): GitHub 공용 토큰(Secret), 특정 workflow만 볼 때 GITHUB_WORKFLOW=ci.yml
GITHUB_TOKEN=
GITHUB_WORKFLOW=
# 외부 조회 캐시: memory | redis
CACHE_TYPE=memory
REDIS_HOST=
REDIS_PASSWORD=

# 소셜 로그인 (X1~X3). 비우면 해당 제공자 비활성. 콜백 주소는 {FRONTEND_BASE_URL}/login/oauth2/code/{github|google}
FRONTEND_BASE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
