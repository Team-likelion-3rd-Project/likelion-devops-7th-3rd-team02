SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/devflow
DB_USERNAME=devflow
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=3600000

# Frontend가 다른 주소에서 Backend를 직접 호출할 때 허용할 주소 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Webhook 공유 토큰 (선택). 배포 기록(D3), Alertmanager(I5)
DEPLOY_WEBHOOK_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=

# 운영 상태(K1·K2·O1·E1~E3): 환경별 Prometheus 주소. 현재 환경 이름은 DEVFLOW_ENV (기본 dev)
DEVFLOW_ENV=dev
PROMETHEUS_URL_DEV=
PROMETHEUS_URL_PRODUCTION=
# 파이프라인(C1)·저장소 연결(G1): GitHub 공용 토큰(Secret), 특정 workflow만 볼 때 GITHUB_WORKFLOW=ci.yml
GITHUB_TOKEN=
GITHUB_WORKFLOW=
# 외부 조회 캐시: memory | redis
CACHE_TYPE=memory
REDIS_HOST=
REDIS_PASSWORD=

# 소셜 로그인 (X1~X3). 비우면 해당 제공자 비활성. 콜백 주소는 {FRONTEND_BASE_URL}/login/oauth2/code/{github|google}
FRONTEND_BASE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
