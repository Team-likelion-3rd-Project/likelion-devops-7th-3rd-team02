{
  "request": {
    "method": "POST",
    "urlPath": "/oauth/github/token",
    "bodyPatterns": [
      {
        "contains": "code=octo"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "gho_octo",
      "token_type": "bearer",
      "scope": "read:user,user:email"
    }
  }
}